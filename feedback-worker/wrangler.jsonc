{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bright-trail-feedback",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "send_metrics": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bright-trail-feedback",
      // CI deploys with the FEEDBACK_D1_DATABASE_ID repo variable in its place.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "CAPTURES", "bucket_name": "bright-trail-feedback-captures" }],
}
