{
  "name": "bright-trail",
  "private": true,
  "workspaces": [
    "shared",
    "content",
    "app"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "node scripts/dev.mjs",
    "app:start": "npm run start -w @bright-trail/app",
    "content:validate": "npm run validate -w @bright-trail/content",
    "content:graph": "npm run graph -w @bright-trail/content",
    "content:generate": "npm run generate -w @bright-trail/content --",
    "content:games": "npm run games -w @bright-trail/content --",
    "content:scenes": "npm run scenes -w @bright-trail/content --",
    "content:slices": "npm run slices -w @bright-trail/content --",
    "content:join": "npm run join -w @bright-trail/content --",
    "content:compare": "npm run compare -w @bright-trail/content --",
    "content:arrays": "npm run arrays -w @bright-trail/content --",
    "content:grid": "npm run grid -w @bright-trail/content --",
    "content:blocks": "npm run blocks -w @bright-trail/content --",
    "content:hops": "npm run hops -w @bright-trail/content --",
    "content:voices": "npm run voices -w @bright-trail/content",
    "content:packs": "npm run packs -w @bright-trail/content",
    "content:publish": "npm run publish-packs -w @bright-trail/content --",
    "build": "npm run build --workspaces --if-present",
    "e2e:build:android": "node scripts/build-android.mjs --e2e",
    "android:build:family": "node scripts/build-android.mjs --family",
    "android:install": "node scripts/install-android.mjs",
    "ota:publish": "node scripts/ota-publish.mjs",
    "e2e:android": "node e2e/scripts/run-android.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-expo": "^58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
